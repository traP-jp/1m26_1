# traQ に登録した OAuth クライアントの ID。
# フロントエンドの VITE_TRAQ_CLIENT_ID と同じ値にする。
TRAQ_CLIENT_ID= 

# confidential クライアント（client_secret 発行済み）の場合のみ設定する。
# 空のままなら、クライアント認証を付けずにトークン交換する。
TRAQ_CLIENT_SECRET=

# traQ API v3 のベース URL。通常は変更不要。
# TRAQ_BASE_URL=https://q.trap.jp/api/v3

# サーバーの待ち受けポート。
# PORT=8080

# CORS で許可するオリジン（カンマ区切り）。
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
